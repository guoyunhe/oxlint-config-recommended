{
  "name": "oxlint-config-recommended",
  "version": "1.1.0",
  "description": "Recommended shareable config for Oxlint",
  "keywords": [
    "code-style",
    "eslint",
    "eslint-plugin-unicorn",
    "eslint-recommended",
    "lint",
    "linting",
    "oxlint",
    "oxlint-config",
    "recommended",
    "shared-config",
    "typescript",
    "typescript-eslint",
    "unicorn"
  ],
  "homepage": "https://github.com/guoyunhe/oxlint-config-recommended#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/oxlint-config-recommended/issues"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/oxlint-config-recommended.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./jsx-a11y": {
      "types": "./dist/jsx-a11y.d.ts",
      "import": "./dist/jsx-a11y.js"
    },
    "./unicorn": {
      "types": "./dist/unicorn.d.ts",
      "import": "./dist/unicorn.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "oxlint": ">=1.89.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
