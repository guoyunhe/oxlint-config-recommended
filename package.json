{
  "name": "oxlint-config-recommended",
  "version": "1.2.1",
  "description": "Recommended shareable config for Oxlint",
  "keywords": [
    "code-style",
    "eslint",
    "eslint-plugin-unicorn",
    "eslint-recommended",
    "lint",
    "linting",
    "oxlint",
    "oxlint-config",
    "recommended",
    "shared-config",
    "typescript",
    "typescript-eslint",
    "unicorn"
  ],
  "homepage": "https://github.com/guoyunhe/oxlint-config-recommended#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/oxlint-config-recommended/issues"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/oxlint-config-recommended.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./jsx-a11y": {
      "types": "./dist/jsx-a11y.d.ts",
      "import": "./dist/jsx-a11y.js"
    },
    "./unicorn": {
      "types": "./dist/unicorn.d.ts",
      "import": "./dist/unicorn.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix src test",
    "prepare": "husky",
    "test": "vitest run"
  },
  "devDependencies": {
    "@guoyunhe/editorconfig": "^0.3.0",
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "oxlint-config-recommended": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "oxlint": ">=1.89.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26.12.1 || ^24.22.1 || ^22.23.4"
  }
}
